# ─────────────────────────────────────────────────────────────────────────────
# Local development environment variables for docker-compose
# Copy this file to .env and fill in the real values.
# NEVER commit a .env file that contains real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USERNAME=tax_user
DB_PASSWORD=tax_password

# ── Keycloak admin console ────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Set to a real key to exercise the LLM pipeline; leave placeholder to use
# WireMock stubs (already wired in integration tests).
OPENAI_API_KEY=sk-placeholder

# ── Twilio SMS (optional — leave placeholders to skip SMS delivery) ───────────
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_FROM_NUMBER=+10000000000

# ── Notification sender ───────────────────────────────────────────────────────
NOTIFICATION_FROM_EMAIL=noreply@taxassessment.local

# ── pgAdmin (only used with --profile tools) ──────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
