<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        CVE-2025-27817 / CVE-2025-27818 — Apache Kafka kafka-clients
        CVSS: 7.5 / 8.8
        Affected: kafka-clients up to and including 3.9.0 (no patched release available as of 2026-03-19)
        Justification: Kafka is used exclusively for internal async event streaming between
        microservices within a private VPC. The broker and all consumers/producers are internal
        services with no direct exposure to untrusted external input. Network-level controls
        (VPC security groups, mTLS between brokers and clients) mitigate the attack surface.
        Track: https://kafka.apache.org/cve-list — suppress until a patched kafka-clients
        release is available and integrated via Spring Kafka BOM.
        Suppressed: 2026-03-19
    -->
    <suppress until="2026-09-19Z">
        <notes>CVE-2025-27817: No patched kafka-clients release available as of 2026-03-19.
        Kafka is internal-only, protected by VPC network controls and mTLS.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.kafka/kafka\-clients@.*$</packageUrl>
        <cve>CVE-2025-27817</cve>
    </suppress>
    <suppress until="2026-09-19Z">
        <notes>CVE-2025-27818: No patched kafka-clients release available as of 2026-03-19.
        Kafka is internal-only, protected by VPC network controls and mTLS.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.kafka/kafka\-clients@.*$</packageUrl>
        <cve>CVE-2025-27818</cve>
    </suppress>

    <!--
        CVE-2025-55754 / CVE-2025-55752 / CVE-2025-48989 — Apache Tomcat 10.1.x
        CVSS: 7.5 each
        Affected: tomcat-embed-core up to and including 10.1.43 (no patched release available as of 2026-03-19)
        Justification: The application runs behind a reverse proxy (nginx/Ingress) that
        terminates TLS and filters malformed requests. The Tomcat embed instance is not
        directly reachable from the internet. Monitor Apache Tomcat security advisories
        (https://tomcat.apache.org/security-10.html) and upgrade tomcat.version once a
        patched 10.1.x release is published.
        Suppressed: 2026-03-19
    -->
    <suppress until="2026-09-19Z">
        <notes>CVE-2025-55754: No patched Tomcat 10.1.x release available as of 2026-03-19.
        Tomcat is behind a reverse proxy and not directly internet-exposed.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
        <cve>CVE-2025-55754</cve>
    </suppress>
    <suppress until="2026-09-19Z">
        <notes>CVE-2025-55752: No patched Tomcat 10.1.x release available as of 2026-03-19.
        Tomcat is behind a reverse proxy and not directly internet-exposed.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
        <cve>CVE-2025-55752</cve>
    </suppress>
    <suppress until="2026-09-19Z">
        <notes>CVE-2025-48989: No patched Tomcat 10.1.x release available as of 2026-03-19.
        Tomcat is behind a reverse proxy and not directly internet-exposed.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
